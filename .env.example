# Dominio público definitivo (sin barra final). Necesario para canonical, Open Graph y sitemap.
VITE_SITE_URL=

# Supabase (captación de consultas). Si se dejan vacíos, el formulario muestra el estado de error
# con el teléfono como alternativa: nunca se simula un envío.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Solo desarrollo/QA: simula un envío correcto del formulario. NUNCA activar en producción.
VITE_LEADS_MOCK=false
